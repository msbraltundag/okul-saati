<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gün Seçin:"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spinnerGunler"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ders Süresi (Dk):"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDersSuresi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="40" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Öğle Arası (Kaçıncı Dersten Sonra?):"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOgleArasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="4" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ders Giriş Saatleri (Alt alta veya virgülle yazın):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGirisSaatleri"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="top|start"
            android:hint="08:30&#10;09:20&#10;10:15&#10;11:05"
            android:inputType="textMultiLine"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" />

        <Button
            android:id="@+id/btnKaydet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Seçili Günü Kaydet" />

        <Button
            android:id="@+id/btnHaftaIcineKopyala"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bu Saatleri Tüm Hafta İçine (Pzt-Cum) Kopyala" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Otomatik Hesaplanan Günlük Tablo Önizlemesi:"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvOnizleme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#EFEFEF"
            android:padding="12dp"
            android:textColor="#222222"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
